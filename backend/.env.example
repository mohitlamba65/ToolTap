# ── LLM Inference Provider ─────────────────────────────────────────────────────
# Supported: "gemini" | "openai" | "github" | "ollama"
MODEL_PROVIDER=github

# ── GitHub Models (recommended — no rate limits with PAT) ──────────────────────
# Browse available models: https://github.com/marketplace/models
GITHUB_TOKEN=your_github_pat_here
GITHUB_BASE_URL=https://models.github.ai/inference
GITHUB_MODEL=openai/gpt-4.1-mini

# ── OpenAI (direct) ────────────────────────────────────────────────────────────
# MODEL_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Google Gemini ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Ollama (local) ─────────────────────────────────────────────────────────────
# MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_THREADS=8
OLLAMA_MODEL=qwen3:4b

# ── Embedding Provider ─────────────────────────────────────────────────────────
# Supported: "gemini" | "openai" | "github"
EMBEDDING_PROVIDER=openai
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Voice & Audio Providers ────────────────────────────────────────────────────
# Provider options: gemini | openai | github
TRANSCRIPTION_PROVIDER=openai
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Text-To-Speech (TTS) options: gemini | openai
TTS_PROVIDER=openai
GEMINI_TTS_MODEL=gemini-2.5-flash-tts-preview
GEMINI_TTS_VOICE=Kore
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ── Action Tools ───────────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ── Mailgun Engine ─────────────────────────────────────────────────────────────
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=your_mailgun_domain_here
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_SENDER_EMAIL=your_sender_email@domain.com

# ── WhatsApp API ───────────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=meta
WHATSAPP_API_URL=https://graph.facebook.com/v25.0
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_API_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_verify_token
WEBHOOK_URL=your_webhook_path

# ── LangSmith Tracing (Optional) ───────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=agent-cli

# ── PostgreSQL & Redis ─────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=tooltap
POSTGRES_PASSWORD=tooltap_secret
POSTGRES_DB=tooltap
POSTGRES_URL=postgresql://tooltap:tooltap_secret@localhost:5433/tooltap?sslmode=disable

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
